{
  "info": {
    "_postman_id": "8c772bae-5ef5-4b92-9aa8-d339669a77a4",
    "name": "cURL Parser API",
    "description": "Tests all HTTP endpoints exposed by the cURL Parser server. Run folders in collection order because the CRUD, cookie-auth, and share-link requests pass values to later requests. Share-link requests require Redis on the server. The binary upload uses README.md; select another local file in Postman if it is unavailable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://curl-parser-production.up.railway.app",
      "type": "string"
    },
    {
      "key": "existingUserId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "createdUserId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "shareToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Admin123!",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "cURL Parser",
      "item": [
        {
          "name": "Parse cURL Command",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"curlCommand\": \"curl -X GET https://api.example.com/users -H \\\"Accept: application/json\\\"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/parse-curl",
            "description": "Converts a cURL command into a structured JSON representation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Parsed data is returned\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json).to.have.property(\"data\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User CRUD",
      "description": "Run this folder in order. Create User stores the generated ID for Update and Delete.",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns a users array\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{existingUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the requested user\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(String(json.data.id)).to.eql(pm.collectionVariables.get(\"existingUserId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test User\",\n  \"email\": \"postman.test@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Created user is returned\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.have.property(\"id\");",
                  "  pm.collectionVariables.set(\"createdUserId\", String(json.data.id));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Created User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Postman User\",\n  \"email\": \"updated.postman@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/{{createdUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"User was updated\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.name).to.eql(\"Updated Postman User\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Created User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{createdUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"User was deleted\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.message).to.eql(\"User deleted successfully\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Content Types",
      "item": [
        {
          "name": "Submit URL-Encoded Form",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "field1",
                  "value": "value1",
                  "type": "text"
                },
                {
                  "key": "field2",
                  "value": "value2",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/form-data"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Form fields are echoed\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.field1).to.eql(\"value1\");",
                  "  pm.expect(json.data.field2).to.eql(\"value2\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload Binary File",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [
                    "README.md"
                  ],
                  "description": "Select any local file if README.md is not available in Postman's working directory."
                }
              ]
            },
            "url": "{{baseUrl}}/api/binary",
            "description": "Uploads one multipart file using the required field name `file`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Uploaded file details are returned\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.fileDetails).to.have.property(\"filename\");",
                  "  pm.expect(json.fileDetails.size).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit XML",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              },
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<request>\n  <item>\n    <name>Test Item</name>\n    <quantity>5</quantity>\n  </item>\n</request>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": "{{baseUrl}}/api/xml"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is XML\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/xml\");",
                  "  pm.expect(pm.response.text()).to.include(\"<status>success</status>\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cookie Authentication",
      "description": "Run in order. Postman's cookie jar stores the HttpOnly auth cookie set by Login.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Auth cookie is set\", () => {",
                  "  pm.expect(pm.response.json().message).to.eql(\"Login successful\");",
                  "  pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.include(\"auth_token=\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Authenticated Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Protected data is returned\", () => {",
                  "  pm.expect(pm.response.json().data).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Logout succeeds\", () => {",
                  "  pm.expect(pm.response.json().message).to.eql(\"Logged out successfully\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Shareable Links",
      "description": "Run in order. These endpoints require the deployed server to have a working Redis connection.",
      "item": [
        {
          "name": "Generate Link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bugId\": \"postman-test-bug\",\n  \"expiration\": \"30m\",\n  \"type\": \"BOTH\",\n  \"withAudio\": true,\n  \"message\": \"Generated by the Postman API test collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/generate-link"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Share token is returned and saved\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.collectionVariables.set(\"shareToken\", json.data.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Validate Link",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/validate-link/{{shareToken}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Link is valid\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.valid).to.eql(true);",
                  "  pm.expect(json.data.bugId).to.eql(\"postman-test-bug\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Dismiss Link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{shareToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/dismiss-link"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Link was dismissed\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.message).to.eql(\"Token dismissed successfully.\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Parameterization",
      "item": [
        {
          "name": "Analyze Network Requests",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"networkRequests\": [\n    {\n      \"id\": \"create-user\",\n      \"type\": \"Fetch/XHR\",\n      \"fullUrl\": \"https://api.example.com/users\",\n      \"method\": \"POST\",\n      \"status\": 201,\n      \"startTime\": 1000,\n      \"requestPayload\": {\n        \"name\": \"Alice\"\n      },\n      \"headers\": {\n        \"request\": {\n          \"Content-Type\": \"application/json\"\n        },\n        \"response\": {\n          \"Content-Type\": \"application/json\"\n        }\n      },\n      \"responseContent\": \"{\\\"user\\\":{\\\"id\\\":\\\"user-123\\\",\\\"name\\\":\\\"Alice\\\"}}\"\n    },\n    {\n      \"id\": \"get-user\",\n      \"type\": \"Fetch/XHR\",\n      \"fullUrl\": \"https://api.example.com/users/user-123\",\n      \"method\": \"GET\",\n      \"status\": 200,\n      \"startTime\": 2000,\n      \"requestPayload\": null,\n      \"headers\": {\n        \"request\": {\n          \"Accept\": \"application/json\"\n        },\n        \"response\": {\n          \"Content-Type\": \"application/json\"\n        }\n      },\n      \"responseContent\": \"{\\\"user\\\":{\\\"id\\\":\\\"user-123\\\",\\\"name\\\":\\\"Alice\\\"}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/parameterization/analyze",
            "description": "Analyzes Fetch/XHR captures and detects values produced by one request and reused by another."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Both requests were analyzed\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.requests).to.be.an(\"array\").with.lengthOf(2);",
                  "  pm.expect(json.meta.inputCount).to.eql(2);",
                  "  pm.expect(json.meta.analyzedCount).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
